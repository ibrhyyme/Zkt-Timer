<mjml>
	<mj-head>
		<mj-title>{{title}}</mj-title>
		<mj-attributes>
			<mj-all font-family="-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
			<mj-text font-size="15px" line-height="1.6" color="#3D4250" padding="0" />
			<mj-section padding="0" />
			<mj-column padding="0" />
		</mj-attributes>
		<mj-style>
			.code-cell {
				width: 40px;
				height: 50px;
				text-align: center;
				vertical-align: middle;
				background: #F7F8FA;
				border: 1px solid #D5D8DF;
				border-radius: 8px;
				font-family: 'Roboto Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
				font-size: 26px;
				font-weight: 700;
				color: #0E1015;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#F3F4F6" width="560px">
		<mj-section padding="32px 0 0">
			<mj-column></mj-column>
		</mj-section>

		<mj-wrapper background-color="#FFFFFF" border="1px solid #E4E6EB" border-radius="12px" padding="0">

			<!-- HEADER: logo + wordmark -->
			<mj-section padding="32px 32px 24px">
				<mj-column>
					<mj-image src="https://zktimer.app/public/images/zkt-logo.png" alt="ZKT Timer" width="56px" height="56px" padding="0" href="https://zktimer.app" />
					<mj-text align="center" font-size="15px" font-weight="700" color="#0E1015" letter-spacing="0.2px" padding="10px 0 0">ZKT Timer</mj-text>
				</mj-column>
			</mj-section>

			<mj-section padding="0 32px">
				<mj-column>
					<mj-divider border-width="1px" border-color="#ECEEF2" padding="0" />
				</mj-column>
			</mj-section>

			<!-- TITLE + INTRO -->
			<mj-section padding="28px 32px 24px">
				<mj-column>
					<mj-text font-size="22px" font-weight="700" line-height="1.3" color="#0E1015">{{title}}</mj-text>
					<mj-text padding="10px 0 0">{{{intro}}}</mj-text>
				</mj-column>
			</mj-section>

			<!-- CODE -->
			<mj-section padding="0 16px">
				<mj-column>
					<mj-text align="center" font-size="11px" font-weight="700" color="#6A7080" letter-spacing="1.5px" padding="0 0 10px">{{code_label}}</mj-text>
					<!-- Inside mj-text, not mj-raw: raw content lands straight in the column's
					     tbody, where a table is invalid and the browser moves it (and the
					     rest of the card) out of place. -->
					<mj-text align="center">
						<table cellpadding="0" cellspacing="0" border="0" align="center" role="presentation" style="margin:0 auto;border-collapse:separate;border-spacing:6px 0">
							<tr>
								{{#each code_chars}}
								<td class="code-cell">{{this}}</td>
								{{/each}}
							</tr>
						</table>
					</mj-text>
					<mj-text align="center" font-size="13px" color="#6A7080" padding="12px 0 0">{{expiry_text}}</mj-text>
				</mj-column>
			</mj-section>

			<!-- SIGNOFF -->
			<mj-section padding="28px 32px 32px">
				<mj-column>
					<mj-text>{{closing}}<br /><strong style="color:#0E1015">{{team}}</strong></mj-text>
				</mj-column>
			</mj-section>

		</mj-wrapper>

		<!-- FOOTER -->
		<mj-section padding="16px 32px 32px">
			<mj-column>
				<mj-text align="center" font-size="12px" color="#8A8F9C">{{footer_rights}}</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
