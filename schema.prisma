generator client {
  provider = "prisma-client-js"
  output   = "./node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccount {
  id                 String      @id @default(uuid())
  email              String      @unique
  pending_email      String?     @unique
  password           String?
  first_name         String
  join_ip            String
  join_country       String
  admin              Boolean     @default(false)
  created_at         DateTime    @default(now())
  last_name          String
  username           String?     @unique
  username_changed_at DateTime?
  // Session epoch: JWTs created before this timestamp are rejected (set on password change/reset to revoke all other sessions)
  tokens_valid_after DateTime?
  verified           Boolean     @default(false)
  email_verified     Boolean     @default(false)
  banned_forever     Boolean     @default(false)
  banned_until       DateTime?
  stripe_customer_id String?     @unique
  is_pro             Boolean     @default(false)
  pro_expires_at     DateTime?
  is_premium         Boolean     @default(false)
  premium_expires_at DateTime?
  revenuecat_user_id   String?   @unique
  iap_platform         String?
  iap_product_id       String?
  iap_original_tx_id   String?
  iap_latest_event_at  DateTime?
  iap_cancellation_at  DateTime?
  iap_billing_issue_at DateTime?
  iap_paused_until     DateTime?
  mod                Boolean     @default(false)
  offline_hash       String?
  unsub_id           String?     @default(uuid())
  last_solve_at              DateTime?
  last_seen_at               DateTime?
  daily_goal_reminder        Boolean     @default(false)
  last_daily_goal_reminder   DateTime?
  daily_goal_count_room_solves Boolean   @default(false)
  // Consent: timestamp when Privacy Policy + Terms of Service were accepted at signup,
  // and the policy version accepted. Null = legacy account created before consent gating.
  terms_accepted_at          DateTime?
  consent_version            String?
  action_log                 ActionLog[]

  algorithm_override            AlgorithmOverride[]
  badges                        Badge[]
  badge_type                    BadgeType[]
  bans                          BanLog[]                @relation("ban_log_banned_user")
  created_bans                  BanLog[]                @relation("ban_log_created_by")
  custom_trainer                CustomTrainer[]
  custom_trainer_downloads      CustomTrainerDownload[] @relation("custom_trainer_download_creator")
  custom_trainer_downloaded     CustomTrainerDownload[] @relation("custom_trainer_download_user")
  custom_trainer_likes          CustomTrainerLike[]     @relation("custom_trainer_like_creator")
  liked_custom_trainers         CustomTrainerLike[]     @relation("custom_trainer_like_user")
  email_log                     EmailLog[]
  forgot_password               ForgotPassword[]
  email_verifications           EmailVerification[]
  image                         Image[]
  integrations                  Integration[]
  metric_logs                   MetricLog[]
  notifications_triggered       Notification[]          @relation("notification_triggering_user")
  notifications                 Notification[]          @relation("notification_for")
  notification_preferences      NotificationPreference?
  profile                       Profile?
  profile_views                 ProfileView[]           @relation("profile_user")
  viewed_profiles               ProfileView[]           @relation("viewer")
  reports_created               Report[]                @relation("report_created_by")
  reports_for                   Report[]                @relation("report_for")
  support_tickets               SupportTicket[]         @relation("support_ticket_created_by")
  support_ticket_messages       SupportTicketMessage[]  @relation("support_ticket_message_sender")
  sessions                      Session[]
  settings                      Setting?
  smart_device                  SmartDevice[]
  cubes                         Cube[]
  cube_mains                    CubeMain[]
  cube_calibrations             CubeCalibration[]
  smart_cube_telemetry          SmartCubeTelemetry[]
  magnet_telemetry              MagnetTelemetry[]
  solves                        Solve[]
  solve_views                   SolveView[]             @relation("solve_view_user")
  viewed_solve                  SolveView[]             @relation("solve_view_viewer")
  timer_background              TimerBackground?
  top_average                   TopAverage[]
  top_solves                    TopSolve[]
  trainer_favorite              TrainerFavorite[]
  trainer_alternatives          TrainerAlternative[]
  alg_sets                      AlgSet[]
  alg_set_saves                 AlgSetSave[]
  user_feature_state            UserFeatureState?
  wca_records                   WcaRecord[]

  // Friendly Room relations
  friendly_rooms_created        FriendlyRoom[]            @relation("friendly_room_creator")
  friendly_room_participations  FriendlyRoomParticipant[]
  friendly_room_chat_messages   FriendlyRoomChat[]        @relation("friendly_room_chat_user")

  // Announcement relations
  announcementViews             AnnouncementView[]

  // Push notification tokens
  pushTokens                    PushToken[]

  // WCA competition notification tracking (auto-managed dedup state)
  wca_competition_notification_states WcaCompetitionNotificationState[]

  // Competition lifecycle notifications (groups, schedule, official results)
  competition_lifecycle_states  CompetitionLifecycleState[]

  // WCA competition competitor follows (Pro feature)
  competition_follows           CompetitionFollow[]

  // Record radar watches (Pro feature)
  record_watches                RecordWatch[]

  // Daily goals
  daily_goals                   DailyGoal[]

  // OLLCP recognition accuracy (per case)
  ollcp_stats                   OllcpStat[]

  // Promo codes
  promo_codes_created           PromoCode[]            @relation("promo_code_creator")
  promo_code_redemptions        PromoCodeRedemption[]   @relation("promo_redemption_user")

  // Activity heartbeats — admin gorunurlugu icin dakika bucket'lari
  activity_heartbeats           UserActivityHeartbeat[] @relation("activity_heartbeat_user")

  // Direct messaging
  conversation_participations   ConversationParticipant[]
  messages_sent                 Message[]                 @relation("message_sender")
  blocks_made                   UserBlock[]               @relation("user_block_blocker")
  blocks_received               UserBlock[]               @relation("user_block_blocked")
  social_preference             SocialPreference?
  message_reports_made          MessageReport[]           @relation("message_report_reporter")
  message_reports_received      MessageReport[]           @relation("message_report_reported")
  message_reports_reviewed      MessageReport[]           @relation("message_report_reviewer")
  message_reactions             MessageReaction[]

  // Online Battle (ranking-battle design 4.10)
  battle_ratings                BattleRating[]
  battle_matches_a              BattleMatch[]             @relation("battle_match_a")
  battle_matches_b              BattleMatch[]             @relation("battle_match_b")
  battle_challenges_sent        BattleChallenge[]         @relation("battle_challenge_from")
  battle_challenges_received    BattleChallenge[]         @relation("battle_challenge_to")

  @@map("user_account")
}

model UserFeatureState {
  id                      String      @id @default(uuid())
  user_id                 String      @unique
  received_welcome_screen Boolean     @default(false)
  updated_at              DateTime    @updatedAt
  created_at              DateTime    @default(now())
  user                    UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_feature_state")
}

model Integration {
  id              String      @id @default(uuid())
  user_id         String
  service_name    String
  auth_token      String
  refresh_token   String
  auth_expires_at BigInt
  wca_id                 String?     @unique
  wca_user_id            String?     @unique
  wca_name               String?
  wca_avatar_url         String?
  wca_country_iso2       String?
  wca_competition_count  Int?
  wca_medal_gold         Int?
  wca_medal_silver       Int?
  wca_medal_bronze       Int?
  wca_record_nr          Int?
  wca_record_cr          Int?
  wca_record_wr          Int?
  wca_show_competitions  Boolean     @default(true)
  wca_show_medals        Boolean     @default(true)
  wca_show_records       Boolean     @default(true)
  wca_show_rank          Boolean     @default(true)
  wca_show_results       Boolean     @default(false)
  // --- Zeka Kupu Turkiye federation identity (service_name = 'zkt') ---------
  // Filled from the federation's /api/oauth/userinfo. zkt_user_id is the OAuth
  // subject and always present; zkt_id is the competition identity and stays
  // null until the member's first ZKT result is published, which is exactly why
  // both are stored — the subject is what links the accounts, the ZKT ID is what
  // the federation's public API is keyed on.
  zkt_user_id            String?     @unique
  zkt_id                 String?     @unique
  zkt_member_no          Int?
  zkt_name               String?
  zkt_avatar_url         String?
  zkt_country_iso2       String?
  // Which parts of the member's ZKT career their profile shows, mirroring the
  // wca_show_* switches above. There is no ZKT equivalent of wca_show_rank
  // (a world ranking is a WCA fact) and no separate "results" switch: the
  // federation publishes career totals, not a result-by-result history.
  zkt_show_competitions  Boolean     @default(true)
  zkt_show_medals        Boolean     @default(true)
  zkt_show_records       Boolean     @default(true)
  zkt_show_pbs           Boolean     @default(true)
  kinch_score            Float?
  sor_single             Int?
  sor_average            Int?
  ranks_updated_at       DateTime?
  revoked_at             DateTime?
  last_synced_at         DateTime?
  created_at             DateTime    @default(now())
  user                   UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wca_records            WcaRecord[]

  @@index([user_id])
  @@index([kinch_score])
  @@index([sor_single])
  @@index([sor_average])
  @@index([revoked_at])
  @@index([service_name])
  @@map("integration")
}

model Notification {
  id                         String       @id @default(uuid())
  user_id                    String
  notification_type          String
  triggering_user_id         String?
  read_at                    DateTime?
  message                    String
  icon                       String
  link                       String
  created_at                 DateTime     @default(now())
  notification_category_name String
  link_text                  String
  subject                    String
  in_app_message             String?
  triggering_user            UserAccount? @relation("notification_triggering_user", fields: [triggering_user_id], references: [id], onDelete: Cascade)
  user                       UserAccount  @relation("notification_for", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([triggering_user_id])
  @@index([user_id])
  @@map("notification")
}

model ActionLog {
  id             String       @id @default(uuid())
  user_email     String?
  action_type    String
  action_details String?
  created_at     DateTime     @default(now())
  user           UserAccount? @relation(fields: [user_email], references: [email], onDelete: Cascade)

  @@map("action_log")
}

model MetricLog {
  id             String        @id @default(uuid())
  user_email     String?
  metric_type    MetricLogType
  metric_value   Float?
  metric_details String?
  created_at     DateTime      @default(now())
  user           UserAccount?  @relation(fields: [user_email], references: [email], onDelete: SetDefault)

  @@index([metric_type])
  @@index([user_email])
  @@map("metric_log")
}

model NotificationPreference {
  id                    String      @id @default(uuid())
  user_id               String      @unique
  created_at            DateTime    @default(now())
  marketing_emails      Boolean     @default(true)
  membership_granted    Boolean     @default(true)
  support_ticket_reply  Boolean     @default(true)
  // Push opt-outs for competition lifecycle notifications. Column names equal
  // the NotificationType values.
  zkt_competition_announced    Boolean @default(true)
  competition_groups_published Boolean @default(true)
  competition_schedule_changed Boolean @default(true)
  competition_results_official Boolean @default(true)
  // Push opt-out for Online Battle duel invites sent from a profile.
  battle_challenge             Boolean @default(true)
  user                  UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notification_preference")
}

model SiteConfig {
  id                   String   @id @default("singleton")
  maintenance_mode     Boolean  @default(false)
  trainer_enabled      Boolean  @default(true)
  community_enabled    Boolean  @default(true)
  leaderboards_enabled Boolean  @default(true)
  rooms_enabled        Boolean  @default(true)
  battle_enabled       Boolean  @default(true)
  messaging_enabled    Boolean  @default(true)
  /// Separate from messaging_enabled on purpose. Presence is the part of a chat system
  /// that scales worst: Matrix turned it off on their flagship server and shipped a
  /// dedicated switch for exactly this reason. If the live dot ever becomes the thing
  /// hurting the server, it has to be possible to drop it without taking messaging
  /// down with it.
  presence_enabled     Boolean  @default(true)
  pro_enabled          Boolean  @default(false)
  wca_backfill_enabled Boolean  @default(true)
  /// Nightly pull that asks the federation for ZKT IDs minted since the last run.
  /// Separate from the WCA switch because the two talk to different parties: this one
  /// only ever calls zekakuputurkiye, so a WCA rate-limit emergency should not silence
  /// it, and a federation outage should not silence WCA.
  zkt_backfill_enabled Boolean  @default(true)
  /// Field study of smart cube behaviour across models. Off by default and meant to be
  /// switched on for a few days at a time: it records one row per solve, so leaving it on
  /// indefinitely grows a table nobody reads.
  smart_telemetry_enabled Boolean @default(false)
  /// Field study of magnet lift-to-start across phone models (MagnetTelemetry). Off by
  /// default, switched on for a study and off again: a row per placement and lift.
  magnet_telemetry_enabled Boolean @default(false)
  /// Online Battle (ranked smart cube matches). Off by default: admins and the users on
  /// this flag's feature_overrides list can play while it is off, so it is tried live
  /// before everyone sees it. The Leaderboard nav entry stays hidden until it is on.
  online_battle_enabled Boolean @default(false)
  /// Bumped by the smart cube method steps reindex when it finishes. Devices only ever
  /// fetch solves they do not have yet, so without this a reindex that repaired a solve's
  /// breakdown on the server never reached the copy the device's stats read from.
  method_steps_version Int      @default(0)
  feature_overrides    Json     @default("{}")
  updated_at           DateTime @updatedAt @default(now())
  updated_by           String?

  @@map("site_config")
}

model Profile {
  id                          String        @id @default(uuid())
  user_id                     String        @unique
  header_image_id             String?       @unique
  pfp_image_id                String?       @unique
  created_at                  DateTime      @default(now())
  bio                         String?
  favorite_event              String?
  main_three_cube             String?
  three_goal                  String?
  three_method                String?
  reddit_link                 String?
  twitch_link                 String?
  youtube_link                String?
  twitter_link                String?
  discord_id                  String?
  show_discord_message_button Boolean       @default(true)
  header_image                Image?        @relation("header_image", fields: [header_image_id], references: [id], onDelete: SetDefault)
  pfp_image                   Image?        @relation("pfp_image", fields: [pfp_image_id], references: [id], onDelete: SetDefault)
  user                        UserAccount   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  views                       ProfileView[]

  @@index([user_id])
  @@map("profile")
}

model Image {
  id                   String      @id @default(uuid())
  user_id              String
  url                  String?
  storage_path         String?
  created_at           DateTime    @default(now())
  user                 UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profile_header_image Profile?    @relation("header_image")
  profile_pfp_image    Profile?    @relation("pfp_image")

  @@index([user_id])
  @@map("image")
}

model ProfileView {
  id              String       @id @default(uuid())
  viewer_id       String?
  profile_id      String
  created_at      DateTime     @default(now())
  profile_user_id String
  profile         Profile      @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  profile_user    UserAccount  @relation("profile_user", fields: [profile_user_id], references: [id], onDelete: Cascade)
  viewer          UserAccount? @relation("viewer", fields: [viewer_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([profile_user_id])
  @@index([viewer_id])
  @@map("profile_view")
}

model ForgotPassword {
  id         String      @id @default(uuid())
  user_id    String
  code       String
  claimed    Boolean     @default(false)
  attempts   Int         @default(0)
  created_at DateTime    @default(now())
  user       UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("forgot_password")
}

model EmailVerification {
  id         String      @id @default(uuid())
  user_id    String
  code       String
  claimed    Boolean     @default(false)
  attempts   Int         @default(0)
  created_at DateTime    @default(now())
  user       UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification")
}

model Solve {
  id                   String            @id @default(uuid())
  user_id              String
  time                 Float
  raw_time             Float?
  cube_type            String?
  scramble_subset      String?
  scramble             String?
  session_id           String?
  started_at           BigInt?
  ended_at             BigInt?
  dnf                  Boolean           @default(false)
  plus_two             Boolean           @default(false)
  notes                String?
  trainer_name         String?
  created_at           DateTime          @default(now())
  bulk                 Boolean           @default(false)
  inspection_time      Float?            @default(0.0)
  is_smart_cube        Boolean           @default(false)
  // Solved on the on-screen keyboard cube rather than a physical one. Kept
  // separate from is_smart_cube because the reconstruction rules differ:
  // virtual solves record their moves for everyone, smart cube solves do not.
  is_virtual_cube      Boolean           @default(false)
  smart_put_down_time  Float?            @default(0.0)
  smart_pick_up_time   Float?            @default(0.0)
  smart_turns          String?
  /// Whole-cube rotations the gyroscope saw, in the cube's core frame, same "x@ms" format and
  /// time base as smart_turns (shared/smart_cube/gyro_rotations.ts). Pro, like smart_turns.
  smart_rotations      String?
  /// Raw gyroscope stream for the realistic replay (shared/smart_cube/gyro_codec.ts, ~4 KB a
  /// solve). Deliberately not in any sync read: the replay fetches it on demand (solveGyro).
  smart_gyro           String?
  /// The owner's verdict on the gyro reconstruction: 1 right, -1 wrong, null unrated. Wrong ones
  /// are exported with their raw stream to tune the detector (scripts/export-reconstruction-feedback.ts).
  reconstruction_vote  Int?
  smart_turn_count     Int?
  smart_device_id      String?
  /// Physical cube the solve was made with (Cube.id). Plain column, no foreign key on purpose:
  /// the solve table is large, and a stale id from the offline queue must never fail a write.
  /// Integrity is kept by the write paths (server/util/solve_links.ts): an unknown id, another
  /// account's cube or a cube of a different puzzle is stored as null.
  cube_id              String?
  share_code           String?           @unique
  from_timer           Boolean           @default(true)
  // Manual multi-phase splits: "<method>:<ms>,<ms>,..." cumulative from timer start.
  // See shared/util/solve/multiphase.ts — deliberately not SolveMethodStep rows, which
  // carry millisecond-accurate smart cube data rather than human reaction time.
  phase_splits         String?
  custom_scramble      Boolean           @default(false)
  training_session_id  String?
  session              Session?          @relation(fields: [session_id], references: [id], onDelete: Cascade)
  smart_device         SmartDevice?      @relation(fields: [smart_device_id], references: [id], onDelete: SetDefault)
  user                 UserAccount       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  solve_method_steps   SolveMethodStep[]
  solve_views          SolveView[]
  top_average_1        TopAverage[]      @relation("solve_1")
  top_average_2        TopAverage[]      @relation("solve_2")
  top_average_3        TopAverage[]      @relation("solve_3")
  top_average_4        TopAverage[]      @relation("solve_4")
  top_average_5        TopAverage[]      @relation("solve_5")
  top_solve            TopSolve[]
  messages             Message[]

  @@index([created_at])
  @@index([session_id])
  @@index([share_code])
  @@index([bulk])
  @@index([started_at])
  @@index([from_timer])
  @@index([training_session_id])
  @@index([trainer_name])
  @@index([user_id])
  @@index([user_id, created_at])
  // Name must stay Prisma's default (solve_cube_id_idx): the owner may build it ahead of the
  // deploy with CREATE INDEX CONCURRENTLY so db push finds nothing to do on the big table.
  @@index([cube_id])
  @@map("solve")
}

model EmailLog {
  id         String       @id @default(uuid())
  user_id    String?
  subject    String
  template   String
  vars       String
  created_at DateTime     @default(now())
  email      String
  user       UserAccount? @relation(fields: [user_id], references: [id], onDelete: SetDefault)

  @@index([user_id])
  @@map("email_log")
}

model SmartDevice {
  id            String      @id @default(uuid())
  name          String
  internal_name String
  created_at    DateTime    @default(now())
  device_id     String
  user_id       String
  user          UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)
  solves        Solve[]

  @@index([user_id])
  @@map("smart_device")
}

/// A physical puzzle the user owns ("My Cubes"). Belongs to exactly one puzzle key
/// (shared/cube_puzzle.ts): a 3x3 cube is offered only in 3x3 buckets. Collections, if they
/// come, are a separate join table; this model does not change for them.
model Cube {
  id                      String            @id @default(uuid())
  user_id                 String
  user                    UserAccount       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// '333', '222', ..., 'fto', or a CustomCubeType id. Never changes after creation.
  puzzle                  String
  name                    String
  brand                   String?
  is_smart                Boolean           @default(false)
  /// BLE device id of a smart cube (what SmartDevice.device_id held). Matches the cube on connect.
  ble_device_id           String?
  /// Advertised BLE name at registration, e.g. "GANi3_F568". Kept for matching across reinstalls.
  ble_name                String?
  /// SmartDevice rows this cube was migrated from. Maps old solve.smart_device_id values.
  legacy_smart_device_ids String[]          @default([])
  archived_at             DateTime?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  mains                   CubeMain[]
  calibrations            CubeCalibration[]

  @@unique([user_id, ble_device_id])
  @@index([user_id, puzzle])
  @@map("cube")
}

/// The cube a user solves with for one puzzle. One row per (user, puzzle).
model CubeMain {
  user_id String
  puzzle  String
  cube_id String
  /// Client time of the choice; the newer choice wins across devices (offline changes included).
  set_at  DateTime
  user    UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cube    Cube        @relation(fields: [cube_id], references: [id], onDelete: Cascade)

  @@id([user_id, puzzle])
  @@index([cube_id])
  @@map("cube_main")
}

/// Magnet calibration of one cube on one phone model. Raw measurements are the source of
/// truth; the thresholds are what the formula of `algo_version` produced at the time
/// (shared/magnet_calibration.ts).
model CubeCalibration {
  id           String      @id @default(uuid())
  cube_id      String
  user_id      String
  cube         Cube        @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  user         UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// ios | android
  platform     String
  /// "Apple iPhone16,1", "samsung SM-F956B" (same helper as MagnetTelemetry).
  device_model String
  os_version   String?
  /// OTA bundle or asset version.
  app_version  String?
  sensor_name  String?

  /// Robust maximum |B - F| during the sweep.
  peak_ut      Float
  /// |R - F| of the cube resting where the user will rest it.
  rest_ut      Float?
  /// rms of the far plateau (phone still, cube away).
  noise_ut     Float
  /// Derived: enter-near threshold (the green line).
  near_min_ut  Float
  /// Derived: leave-near / far band (hysteresis).
  far_max_ut   Float
  /// ok | weak
  quality      String
  sample_count Int
  sweep_ms     Int
  rate_hz      Float
  algo_version Int         @default(1)
  /// Client time of the measurement; a newer upload replaces an older one, never the reverse.
  measured_at  DateTime
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@unique([cube_id, platform, device_model])
  @@index([user_id])
  @@index([device_model])
  @@map("cube_calibration")
}

/// One row per smart cube solve (plus anomaly rows), recorded only while
/// SiteConfig.smart_telemetry_enabled is on. Exists to answer a question the codebase
/// cannot: which cube models report clean move streams and which ones lean on the
/// facelets fallbacks, measured across real users instead of the three cubes on one desk.
///
/// Deliberately free of solve content: no scramble, no move list, no times beyond the
/// duration. Deleting a user cascades their rows away.
model SmartCubeTelemetry {
  id       String  @id @default(uuid())
  user_id  String?
  user     UserAccount? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// Advertised BLE name, e.g. "GANi4_F568". Identifies the model, not the person.
  device_name String
  /// Protocol class picked by createCubeForDevice: GAN, MoYu, QiYi, Giiker, Particula.
  cube_type   String
  /// Which screen produced this: timer, room, trainer.
  surface     String
  /// solve | out_of_sync | late_scramble_move | scan_error | disconnect
  event_type  String

  /// For solve rows: which detection path finished it (tracker, facelets-grace, facelets-poll).
  detection_source String?
  /// Milliseconds between the last physical move and the app noticing the solve ended.
  /// This is the number that shows up to a user as the timer "jumping backwards".
  detection_lag_ms Int?
  time_ms          Int?
  turn_count       Int?

  /// Cube battery percentage at the time of the event. A weak transmitter drops more BLE
  /// packets, so this is the column that tests whether "the cube misbehaves when low" is
  /// real or folklore. Null when the cube never reported a level.
  battery_level Int?

  /// Milliseconds added to a solve because its final move packet was lost and the linear
  /// fit therefore ended early. Zero on clean solves. Exists so the correction can be
  /// verified against real solves rather than assumed to work.
  time_correction_ms Int?

  /// Moves of the solve that came back from the cube's move history after their packet was
  /// lost (they carry no cube timestamp; the blue "?" moves of the battle admin). Counts GAN
  /// Gen3/Gen4 only, the protocols that recover this way. Null on rows from older apps.
  recovered_moves Int?

  is_native   Boolean @default(false)
  app_version String?

  created_at DateTime @default(now())

  @@index([created_at])
  @@index([cube_type, event_type])
  @@map("smart_cube_telemetry")
}

/// Field study of magnet lift-to-start across phone models and cubes, recorded only while
/// SiteConfig.magnet_telemetry_enabled is on. Answers what two phones on one desk cannot:
/// whether the 150 uT placement threshold, the lift detection and the 40 Hz sensor floor
/// hold on every phone people actually own.
///
/// No solve content. Deleting a user cascades their rows away. Removing this model later
/// leaves the table behind and `db push` then refuses to start the container: drop the
/// table on the server first (see the orphan-table note in CLAUDE.md's change safety rules).
model MagnetTelemetry {
  id      String       @id @default(uuid())
  user_id String?
  user    UserAccount? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// ios | android
  platform     String
  /// Manufacturer and model as the device reports them, e.g. "samsung SM-F956B".
  device_model String
  os_version   String?
  /// Native sensor name, e.g. "AK09918 Magnetometer-Uncalibrated", "CMMagnetometer".
  sensor_name  String?
  /// device | near | lift | reject | unsupported | hint | far_learned | touch_ignored
  event_type   String
  /// Event label: lift decision (startTimer, none:not_armed, ...), reject reason, hint kind,
  /// far_learned source, touch_ignored reason, near replaced/resumed.
  detail       String?

  /// near / lift: |R - F| of the placement. hint: |B - F|. far_learned: the shift.
  delta_ut    Float?
  /// lift: trigger to confirmation.
  latency_ms  Int?
  /// lift: how long the cube rested before it was lifted.
  rest_ms     Int?
  /// near: time spent in the "move closer" band before the placement was recognised.
  approach_ms Int?
  /// Plateau noise (rms) of the placement, or of the far rest on device rows.
  sigma       Float?
  /// device / unsupported: measured sensor delivery rate.
  rate_hz     Float?
  /// The phone lay upside down (reversed use).
  reversed    Boolean @default(false)
  /// Raw sample window in the test-fixture format, only on flagged events. Not called
  /// `window`: that is a reserved word in Postgres and every raw query would need quoting.
  samples     Json?

  /// Puzzle key of the cube in use (shared/cube_puzzle.ts), so per-model summaries do not mix
  /// a 2x2 with a 3x3. Null on rows recorded before cubes existed.
  cube_puzzle String?
  /// The "ready" threshold the detector ran with (calibrated or default).
  near_min_ut Float?

  app_version String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([device_model, event_type])
  @@map("magnet_telemetry")
}

