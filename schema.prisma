// ==========================================
// DIRECT MESSAGING
// ==========================================

// Who may open a conversation with this user.
enum DmPolicy {
  EVERYONE // any account can land straight in the inbox
  KNOWN    // strangers go to the request box first (default)
  NOBODY   // no new conversations at all
}

model Conversation {
  id              String   @id @default(uuid())
  created_at      DateTime @default(now())
  // Denormalised so the inbox can sort without touching the message table.
  last_message_at DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([last_message_at])
  @@map("conversation")
}

model ConversationParticipant {
  id              String    @id @default(uuid())
  conversation_id String
  user_id         String
  // Null while the conversation is still sitting in this user's request box.
  // The opener is accepted immediately; the recipient accepts by replying.
  accepted_at     DateTime?
  last_read_at    DateTime?
  // "Delete chat" is one-sided, exactly like every other messenger: messages older
  // than this are hidden from this participant only, and the other person's copy is
  // untouched. Deleting the row instead would take the thread away from both sides.
  cleared_at      DateTime?
  // Denormalised counter: the inbox badge must not COUNT() the message table,
  // which will be the largest table in the schema.
  unread_count    Int       @default(0)
  archived        Boolean   @default(false)
  /// Silences notifications for this one conversation, for this participant only.
  ///
  /// The step that was missing between putting up with someone and blocking them.
  /// Muting is invisible to the other side by design: they keep writing normally and
  /// are never told, which is the whole reason it is safer to offer than a block.
  muted           Boolean   @default(false)
  created_at      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         UserAccount  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id, accepted_at])
  @@index([user_id, archived])
  @@map("conversation_participant")
}

model Message {
  id              String    @id @default(uuid())
  conversation_id String
  sender_id       String
  body            String
  // Optional attached solve: the cubing-specific payload a generic chat app cannot
  // render. SetNull so deleting a solve leaves the message text intact.
  solve_id        String?
  // Soft delete: the row stays so the other side's unread counter stays consistent.
  deleted_at      DateTime?
  /// Set the first time the text is changed, and shown to both sides as "edited".
  ///
  /// Only the timestamp is kept, never the previous text. Storing old versions would
  /// build a private archive of things people deliberately took back, sitting right
  /// next to the promise on the messages screen that we do not read their messages.
  /// A report already captures a frozen copy at the moment it is filed, so moderation
  /// does not need edit history either.
  edited_at       DateTime?
  /// The message this one answers, WhatsApp style. SetNull rather than Cascade: a
  /// reply is its own message and must survive the retention sweep deleting the line
  /// it was answering. Soft-deleted (unsent) parents keep their row, so the quote can
  /// still render "message removed" instead of vanishing.
  reply_to_id     String?
  created_at      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       UserAccount  @relation("message_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  solve        Solve?       @relation(fields: [solve_id], references: [id], onDelete: SetNull)
  reply_to     Message?     @relation("message_reply", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("message_reply")
  reactions    MessageReaction[]

  // Cursor pagination reads newest-first within one conversation.
  @@index([conversation_id, created_at])
  @@index([sender_id])
  @@map("message")
}

/// One emoji reaction on a message.
///
/// Unique per (message, user) rather than per emoji: a person has one reaction on a
/// message, and picking another replaces it. That is how WhatsApp and Instagram behave,
/// and it keeps a single tap from turning into a pile of six emojis from one person.
///
/// The emoji itself is validated against a fixed set on the server. Storing arbitrary
/// user-supplied unicode would mean rendering whatever anyone types, which is a
/// moderation surface nobody asked for.
model MessageReaction {
  id         String   @id @default(uuid())
  message_id String
  user_id    String
  emoji      String
  created_at DateTime @default(now())

  message Message     @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([message_id])
  @@map("message_reaction")
}

model UserBlock {
  id         String   @id @default(uuid())
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker UserAccount @relation("user_block_blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked UserAccount @relation("user_block_blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
  @@map("user_block")
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// A user-submitted report about a conversation.
///
/// Moderation deliberately works on a copy, not on the live thread. There is no admin
/// screen that opens someone's inbox, and there never should be: the only message text
/// a moderator ever sees is what the reporter chose to hand over at the moment they
/// pressed report. That keeps the promise made on the messages screen honest, and it is
/// the same shape WhatsApp uses to stay moderatable without reading conversations.
model MessageReport {
  id              String       @id @default(uuid())
  conversation_id String
  reporter_id     String
  reported_id     String
  reason          String
  /// Frozen plain-text copy of the last few messages, captured at report time.
  /// Immutable on purpose: later edits or deletions must not rewrite the evidence.
  snapshot        Json
  status          ReportStatus @default(OPEN)
  moderator_note  String?
  reviewed_at     DateTime?
  reviewed_by_id  String?
  created_at      DateTime     @default(now())

  reporter    UserAccount  @relation("message_report_reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported    UserAccount  @relation("message_report_reported", fields: [reported_id], references: [id], onDelete: Cascade)
  reviewed_by UserAccount? @relation("message_report_reviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  // One open report per reporter per conversation; re-reporting an already open
  // thread should not flood the queue.
  @@index([status, created_at])
  @@index([reporter_id])
  @@index([reported_id])
  @@map("message_report")
}

// Privacy knobs for /account/social. Separate from Setting (timer behaviour) and
// NotificationPreference (email opt-outs) because this governs who may reach you.
model SocialPreference {
  id         String   @id @default(uuid())
  user_id    String   @unique
  dm_policy  DmPolicy @default(KNOWN)
  // Opt out of the user search so nobody can look you up by name.
  searchable Boolean  @default(true)
  dm_push    Boolean  @default(true)
  /// All three of these are RECIPROCAL, the way WhatsApp treats read receipts: turning
  /// one off hides your state from others AND hides theirs from you. Making it
  /// one-sided would turn a privacy control into a surveillance advantage for whoever
  /// switched it off, which is exactly what the reciprocity rule exists to prevent.
  /// Never gate any of them behind Pro for the same reason.
  read_receipts     Boolean @default(true)
  typing_indicator  Boolean @default(true)
  /// Whether a live green dot is shown to people you have an accepted conversation
  /// with. Deliberately online/offline only: there is no "last seen" anywhere in this
  /// schema and there should not be. A stored timestamp of when someone stopped using
  /// the app reveals sleep and work patterns, and it turns an ephemeral signal into
  /// retained personal data with a retention question attached. Presence here is read
  /// from live socket connections and never written down.
  online_status     Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt @default(now())

  user UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("social_preference")
}

// ── Online Battle (ranking-battle design 4.10) ──────────────────────────────
// Ranked smart cube matches. The old competitive match tables (match, match_lobby,
// elo_rating, elo_log ...) are not reused: new names carry the battle_ prefix.

/// A player's Glicko-2 rating for one puzzle. Created by the player's first rated match
/// (win or lose), which is also when they appear on the leaderboard.
model BattleRating {
  id            String    @id @default(uuid())
  user_id       String
  puzzle        String    @default("333")
  rating        Float     @default(1500)
  rd            Float     @default(350)
  volatility    Float     @default(0.06)
  games         Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  draws         Int       @default(0)
  peak_rating   Float     @default(1500)
  /// When RD was last brought up to date. Idle days grow RD from here at the next match.
  last_match_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  user          UserAccount @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, puzzle])
  @@index([puzzle, rating])
  @@map("battle_rating")
}

/// One finished (or voided) match. Players are SetNull on account deletion so the match
/// stays in the opponent's history as a deleted account.
model BattleMatch {
  id              String    @id @default(uuid())
  puzzle          String    @default("333")
  /// FINISHED | VOID
  status          String
  /// NORMAL | FORFEIT | DISCONNECT | ABANDON | SERVER_RESTART
  end_reason      String
  rated           Boolean
  is_rematch      Boolean   @default(false)
  /// A duel (invite link or profile challenge): never rated, outside the daily pair limit.
  is_challenge    Boolean   @default(false)
  player_a_id     String?
  player_b_id     String?
  /// A | B | DRAW, null for a void match without a result
  winner          String?
  rounds_a        Int       @default(0)
  rounds_b        Int       @default(0)
  /// Glicko state each player entered the match with (idle RD growth applied). Null when unrated.
  rating_a_before Float?
  rating_a_after  Float?
  rating_b_before Float?
  rating_b_after  Float?
  rd_a_before     Float?
  rd_b_before     Float?
  /// Kept so an admin void can put the rating row back exactly.
  vol_a_before    Float?
  vol_b_before    Float?
  flags           String[]  @default([])
  started_at      DateTime
  ended_at        DateTime  @default(now())
  /// Set when an admin voided a finished match.
  voided_at       DateTime?
  voided_by_id    String?
  player_a        UserAccount? @relation("battle_match_a", fields: [player_a_id], references: [id], onDelete: SetNull)
  player_b        UserAccount? @relation("battle_match_b", fields: [player_b_id], references: [id], onDelete: SetNull)
  rounds          BattleRound[]
  reports         Report[]

  @@index([player_a_id, ended_at])
  @@index([player_b_id, ended_at])
  @@index([ended_at])
  @@map("battle_match")
}

/// One round of a match, with both move logs for later review.
model BattleRound {
  id          String   @id @default(uuid())
  match_id    String
  index       Int
  scramble    String
  a_time_ms   Int?
  /// PLUS_TWO | PLUS_FOUR | DNF
  a_penalty   String?
  b_time_ms   Int?
  b_penalty   String?
  /// A | B | DRAW
  winner      String
  a_moves     Json?
  b_moves     Json?
  a_flags     String[] @default([])
  b_flags     String[] @default([])
  /// Why the side's solve became DNF (BattleDnfReason), null otherwise. Without it the admin
  /// could not tell a replay failure from an inspection overrun.
  a_dnf_reason String?
  b_dnf_reason String?
  match       BattleMatch @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([match_id, index])
  @@map("battle_round")
}

/// A duel invite (Online Battle without rating). Single use, 15 minutes. The match it
/// started is written to battle_match with is_challenge = true; match_id is a plain id
/// because that row only exists once the match ends.
model BattleChallenge {
  id             String       @id @default(uuid())
  /// Link code: /duel/<code>
  code           String       @unique
  from_user_id   String
  /// Set for a profile challenge (only that user may accept), null for a shared link.
  to_user_id     String?
  /// PENDING | ACCEPTED | EXPIRED | CANCELLED
  status         String       @default("PENDING")
  expires_at     DateTime
  /// Who accepted (equals to_user_id for a profile challenge).
  accepted_by_id String?
  accepted_at    DateTime?
  match_id       String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  from_user      UserAccount  @relation("battle_challenge_from", fields: [from_user_id], references: [id], onDelete: Cascade)
  to_user        UserAccount? @relation("battle_challenge_to", fields: [to_user_id], references: [id], onDelete: Cascade)

  @@index([from_user_id, created_at])
  @@index([to_user_id, created_at])
  @@index([status, expires_at])
  @@map("battle_challenge")
}
