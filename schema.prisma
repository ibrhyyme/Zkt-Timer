enum AnnouncementCategory {
  FEATURE    // Yenilik
  BUGFIX     // Düzeltme
  IMPORTANT  // Önemli
  INFO       // Bilgilendirme

  @@map("announcement_category")
}

model Announcement {
  id          String                @id @default(uuid())
  title       String
  content     String                @db.Text  // Markdown content
  category    AnnouncementCategory  @default(INFO)
  priority    Int                   @default(0)  // Yüksek = daha önemli (0-10)
  imageUrl    String?               @map("image_url")  // Opsiyonel header resmi
  isDraft     Boolean               @default(false) @map("is_draft")  // Taslak mı?
  createdAt   DateTime              @default(now()) @map("created_at")
  publishedAt DateTime?             @map("published_at")  // Yayınlanma tarihi
  isActive    Boolean               @default(true) @map("is_active")
  // Whether the announcement opens as a full-screen popup on next app load.
  // Off means notification-only: the push still goes out and the item stays in
  // the inbox, but nothing interrupts the user. Defaults on so every existing
  // announcement keeps the behaviour it was created with.
  showInApp   Boolean               @default(true) @map("show_in_app")
  targetUrl   String?               @map("target_url")  // Bildirime tiklayinca yonlendirilecek sayfa: "/pro" veya "https://..."
  translations Json?                               // {"en": {"title":"...","content":"..."}, "es": {...}, "ru": {...}, "zh": {...}}

  // Push delivery stats (written after fire-and-forget push completes)
  pushSentAt       DateTime? @map("push_sent_at")       // When the push send finished
  pushSuccessCount Int?      @map("push_success_count")  // Devices FCM accepted delivery to
  pushTargetCount  Int?      @map("push_target_count")   // Total target tokens at send time

  views AnnouncementView[]

  @@index([isActive])
  @@index([isDraft])
  @@index([publishedAt])
  @@map("announcements")
}

