/// Trainer algorithm set: a free list of cases, each with the algorithm its owner chose.
/// Design .feedback/designs/trainer-sets.md section 3. Independent of learned flags and stats.
model AlgSet {
  id            String       @id @default(uuid())
  /// Short share code used in every URL (/trainer/sets/<code>). 10 chars base62.
  code          String       @unique
  user_id       String
  name          String
  description   String?
  /// private | link | public. String, not a DB enum, so a later level is an additive change.
  visibility    String       @default("private")
  item_count    Int          @default(0)
  save_count    Int          @default(0)
  /// Sorted distinct item categories and puzzles, wrapped in commas (",OLL,PLL,", ",333,") so a
  /// filter is one `contains ',OLL,'`; used for list badges and filters.
  categories    String       @default("")
  puzzles       String       @default("")
  /// First time the set became public; "new" sort key.
  published_at  DateTime?
  /// Moderation. A hidden set is listed nowhere and opens only for its owner and staff.
  hidden_at     DateTime?
  hidden_reason String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  user          UserAccount  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items         AlgSetItem[]
  saves         AlgSetSave[]
  reports       Report[]

  @@index([user_id])
  @@index([visibility, published_at])
  @@index([visibility, save_count])
  @@map("alg_set")
}

model AlgSetItem {
  id         String   @id @default(uuid())
  set_id     String
  /// default-algs.json category key ("OLL") and case name, unique inside the category ("OLL 45").
  category   String
  case_name  String
  /// Filled by the server from default-algs.json, never trusted from the client.
  subset     String
  puzzle     String
  /// The algorithm the set owner chose for this case, stored as the matching source writes it.
  algorithm  String
  position   Int
  created_at DateTime @default(now())
  set        AlgSet   @relation(fields: [set_id], references: [id], onDelete: Cascade)

  @@unique([set_id, category, case_name])
  @@index([set_id, position])
  @@map("alg_set_item")
}

