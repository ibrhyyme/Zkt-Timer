// after a competition ends, while WCA results turn official weeks later.
//
// One watch per competition. `competition_id` is the WCA id or `zkt-<slug>`.
model CompetitionLifecycleWatch {
  competition_id        String    @id
  source                String // 'wca' | 'zkt'
  name                  String    @default("")
  timezone              String?
  start_date            DateTime  @db.Date
  end_date              DateTime  @db.Date
  next_check_at         DateTime  @default(now())
  // Null until the cron has read this competition's WCIF once. Registrants found
  // on that first read are seeded silently (what already happened is not news);
  // anyone matched on a later read is new and gets the normal flow.
